<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme_UniTime" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/unitime_mint</item>
        <item name="android:statusBarColor">@color/unitime_navy</item>
        <item name="android:navigationBarColor">@color/unitime_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/unitime_paper</item>
    </style>

    <style name="Theme_UniTime_Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/unitime_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/unitime_splash_288x288</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/unitime_navy</item>
        <item name="postSplashScreenTheme">@style/Theme_UniTime</item>
    </style>
</resources>
